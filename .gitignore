# Dependency folders are re-downloaded from package.json, never committed.
node_modules

# Build output — regenerated by each service's build script.
dist

# Secrets and local config — copy .env.example instead.
.env
.env.*.local

# Vercel CLI's local project link, written by `vercel link`/`vercel pull`.
.vercel

# TypeScript incremental build info.
*.tsbuildinfo

# Scratch notes for the developer only — not part of the shipped app.
todo.md

# macOS Finder metadata.
.DS_Store
