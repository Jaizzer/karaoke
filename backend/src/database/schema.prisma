// Prisma schema — the single source of truth for the database shape.
// `npx prisma migrate dev` diffs this file against the database and writes
// a new SQL migration for the difference; `npx prisma generate` (part of
// `npm run build`) turns it into the typed client imported from
// ./generated/client.ts.
//
// The four models below (User, Session, Account, Verification) are the
// exact shape Better Auth's Prisma adapter expects — see src/lib/auth.ts.
// Don't rename their fields/tables without also checking Better Auth's
// docs; it queries them by these names. App-specific models belong here
// too, related back to `User` the same way Session/Account are.

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  hostedRooms   Room[]

  @@map("user")
}

// One row per active login — this is what a session cookie's token maps to.
// Better Auth checks `expiresAt` on every authenticated request and deletes
// the row on sign-out.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

// One row per way a User can authenticate: `providerId: "credential"` for
// email+password (with the hashed password in the `password` column), or
// `providerId: "google"` for an OAuth-linked Google account. A single User
// can have both at once, which is how "sign in with Google OR password"
// works for the same account.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// Short-lived tokens for flows that aren't a logged-in session yet — email
// verification links and password-reset links. `identifier` is typically
// the user's email; `value` is the token itself.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum RoomStatus {
  OPEN
  CLOSED
}

enum QueueItemStatus {
  QUEUED
  PLAYING
  PLAYED
  REMOVED
}

// A karaoke session a host runs. `code` is the short string encoded in the
// QR guests scan to join (see room-members below) — unique so it can be
// looked up directly, with no numeric id exposed to guests.
model Room {
  id              String       @id @default(uuid())
  code            String       @unique
  name            String?
  hostId          String
  host            User         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  autoSelect      Boolean      @default(false)
  // Whether search results are LLM-ranked/filtered (llm.ts) or just
  // YouTube's own raw relevance order — a host can turn this off to avoid
  // the LLM's variable latency and lean on YouTube's own search instead.
  aiSearchEnabled Boolean      @default(true)
  // When on, every search query is sent to YouTube with " karaoke"
  // appended (search.service.ts), biasing results toward singable
  // instrumental/backing-track versions instead of original recordings.
  appendKaraoke   Boolean      @default(true)
  status          RoomStatus   @default(OPEN)
  createdAt       DateTime     @default(now())
  members         RoomMember[]
  queueItems      QueueItem[]

  @@index([hostId])
  @@map("room")
}

// A guest inside a Room. Guests don't get a Better Auth User — joining a
// room (see room-members below) creates this row and hands back
// `sessionToken` as a bearer token, which is all that's needed to prove
// "this is the same guest" on later requests (queueing a song, removing
// their own queue item). One row per guest per room, not one per guest
// overall.
model RoomMember {
  id           String      @id @default(uuid())
  roomId       String
  room         Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  displayName  String
  sessionToken String      @unique
  createdAt    DateTime    @default(now())
  queueItems   QueueItem[]

  @@index([roomId])
  @@map("room_member")
}

// One song queued in a Room. `status` tracks it through the queue:
// QUEUED -> PLAYING (host started it) -> PLAYED (finished, host can
// advance to the next QUEUED item) or REMOVED (deleted by the member who
// added it, or by the host). Ordered FIFO by `createdAt` — no manual
// reorder yet.
model QueueItem {
  id             String          @id @default(uuid())
  roomId         String
  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  addedById      String
  addedBy        RoomMember      @relation(fields: [addedById], references: [id], onDelete: Cascade)
  youtubeVideoId String
  title          String
  channelTitle   String
  thumbnailUrl   String
  status         QueueItemStatus @default(QUEUED)
  createdAt      DateTime        @default(now())
  startedAt      DateTime?
  endedAt        DateTime?

  @@index([roomId])
  @@index([addedById])
  @@map("queue_item")
}
